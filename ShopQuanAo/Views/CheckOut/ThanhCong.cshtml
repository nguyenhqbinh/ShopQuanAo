
@{
    ViewBag.Title = "ThanhCong";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@model ShopQuanAo.Models.DonHang


<section class="checkout-section spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- THÔNG BÁO -->
                <div class="alert alert-success text-center">
                    <h3>🎉 Đặt hàng thành công!</h3>
                    <p>Cảm ơn bạn đã mua hàng tại cửa hàng của chúng tôi.</p>
                </div>

                <!-- THÔNG TIN ĐƠN HÀNG -->
                <div class="checkout-form">
                    <h4>Thông tin đơn hàng</h4>

                    <div class="row">
                        <div class="col-lg-6">
                            <p><strong>Mã đơn hàng:</strong> @Model.MaDonHang</p>
                            <p><strong>Ngày đặt:</strong> @Model.NgayDatHang.ToString("dd/MM/yyyy HH:mm")</p>
                            <p>
                                <strong>Tổng tiền:</strong>
                                <span class="text-danger">
                                    @Model.TongTien.ToString("N0") đ
                                </span>
                            </p>
                        </div>

                        <div class="col-lg-6">
                            <p><strong>Khách hàng:</strong> @Model.KhachHang.HoTenKhachHang</p>
                            <p><strong>Số điện thoại:</strong> @Model.KhachHang.DienThoai</p>
                            <p><strong>Địa chỉ:</strong> @Model.KhachHang.DiaChi</p>
                        </div>
                    </div>
                </div>

                <!-- CHI TIẾT ĐƠN HÀNG -->
                <div class="cart-table" style="margin-top:40px">
                    <h4>Chi tiết đặt hàng</h4>

                    <table>
                        <thead>
                            <tr>
                                <th>Hình ảnh</th>
                                <th class="p-name">Sản phẩm</th>
                                <th>Giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ChiTietDonHangs)
                            {
                                <tr>
                                    <td class="cart-pic first-row">
                                        <img src="~/Content/img/QuanAo/@item.QuanAo.HinhAnh"
                                             alt="@item.QuanAo.TenQuanAo"
                                             style="width:80px" />
                                    </td>
                                    <td class="cart-title first-row">
                                        <h5>@item.QuanAo.TenQuanAo</h5>
                                    </td>
                                    <td class="p-price first-row">
                                        @item.GiaBan.ToString("N0") đ
                                    </td>
                                    <td class="qua-col first-row">
                                        @item.SoLuong
                                    </td>
                                    <td class="total-price first-row">
                                        @( (item.GiaBan * item.SoLuong).ToString("N0") ) đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- NÚT ĐIỀU HƯỚNG -->
                <div class="row" style="margin-top:40px">
                    <div class="col-lg-12 text-center">
                        <a href="@Url.Action("Index","Home")" class="primary-btn">
                            Quay về trang chủ
                        </a>
                        <a href="@Url.Action("Index","Nhom")" class="site-btn">
                            Tiếp tục mua sắm
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>