
@{
    ViewData["Title"] = "Lienhe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Action("Header", "Home")
<!-- Breadcrumb Section Begin -->
<div class="breacrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-text">
                    <a href="#"><i class="fa fa-home"></i> Home</a>
                    <span>Contact</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb Section Begin -->
<!-- Map Section Begin -->
<div class="map spad">
    <div class="container">
        <div class="map-inner">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3885.5980482538257!2d109.28898527488512!3d13.124631011505048!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x316fec84506f93f9%3A0x3098e63f0136f63f!2zMTc2IMSQLiBUw6JuIFRyw6BvLCBCw6xuaCBLaeG6v24sIFR1eSBIw7JhLCBQaMO6IFnDqm4sIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1748616555936!5m2!1svi!2s" width="600" height="550" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            <div class="icon">
                <i class="fa fa-map-marker"></i>
            </div>
        </div>
    </div>
</div>
<!-- Map Section Begin -->
<!-- Contact Section Begin -->
<section class="contact-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-5">
                <div class="contact-title">
                    <h4>Liên hệ với chúng tôi</h4>
                    <p>
                        Chúng tôi luôn sẵn sàng hỗ trợ bạn! Nếu bạn có bất kỳ câu hỏi,
                        góp ý hoặc nhu cầu hợp tác nào, vui lòng liên hệ qua thông tin bên dưới.
                    </p>
                </div>
                <div class="contact-widget">
                    <div class="cw-item">
                        <div class="ci-icon">
                            <i class="ti-location-pin"></i>
                        </div>
                        <div class="ci-text">
                            <span>Địa chỉ:</span>
                            <p>176 Tân Trào Bình Kiến Tuy Hòa Phú Yên</p>
                        </div>
                    </div>
                    <div class="cw-item">
                        <div class="ci-icon">
                            <i class="ti-mobile"></i>
                        </div>
                        <div class="ci-text">
                            <span>Điện thoại:</span>
                            <p>0379812607</p>
                        </div>
                    </div>
                    <div class="cw-item">
                        <div class="ci-icon">
                            <i class="ti-email"></i>
                        </div>
                        <div class="ci-text">
                            <span>Email:</span>
                            <p>nguyenhaquangbinh05@gmail.com</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 offset-lg-1">
                <div class="contact-form">
                    <div class="leave-comment">
                        <h4>Gửi lời nhắn</h4>
                        <p>Bạn có thắc mắc hoặc góp ý? Hãy để lại lời nhắn, chúng tôi sẽ phản hồi trong thời gian sớm nhất.</p>
                        <form action="#" class="comment-form">
                            <div class="row">
                                <div class="col-lg-6">
                                    <input type="text" placeholder="Họ và tên">
                                </div>
                                <div class="col-lg-6">
                                    <input type="text" placeholder="Nhập email">
                                </div>
                                <div class="col-lg-12">
                                    <textarea placeholder="Tin nhắn của bạn"></textarea>
                                    <button type="submit" class="site-btn">Gửi tin nhắn</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->
@Html.Action("Footer", "Home")