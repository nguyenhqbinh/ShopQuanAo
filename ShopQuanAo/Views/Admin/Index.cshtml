            text-align: center;
            padding: 15px;
            border: 1px solid #ebebeb;
        }

        .admin-table tbody tr td {
            padding: 12px;
            border: 1px solid #ebebeb;
            text-align: center;
            vertical-align: middle;
        }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        flex-wrap: wrap;
