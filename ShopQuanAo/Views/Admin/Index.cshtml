        .action-buttons .btn {
            font-family: 'Muli', sans-serif;
            font-size: 12px;
            padding: 5px 10px;
        }

    .badge {
        padding: 5px 10px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-danger {
        background-color: #dc3545;
        color: white;
    }

    .badge-primary {
        background-color: #007bff;
        color: white;
    }

    .change-role {
        font-size: 12px;
