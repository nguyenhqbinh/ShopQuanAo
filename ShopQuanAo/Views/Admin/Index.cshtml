<section class="admin-dashboard spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h2 class="admin-title text-center">Quản lý hệ thống</h2>
            </div>
        </div>

        <div class="row admin-box-wrap">
            <!-- Quản lý tài khoản -->
            <div class="col-lg-4 col-md-6">
                <a href="@Url.Action("UserManagement", "Admin")" class="admin-box">
                    <i class="fa fa-users"></i>
                    <h4>Quản lý tài khoản</h4>
                    <p>Xem, sửa, phân quyền người dùng</p>
                </a>
            </div>

            <!-- Quản lý sản phẩm -->
            <div class="col-lg-4 col-md-6">
                <a href="@Url.Action("Index", "AdminQuanAo")" class="admin-box">
                    <i class="fa fa-list"></i>
                    <h4>Quản lý sản phẩm</h4>
                    <p>Chỉnh sửa, cập nhật sản phẩm</p>
                </a>
            </div>

            <!-- Đăng sản phẩm -->
            <div class="col-lg-4 col-md-6">
                <a href="@Url.Action("Index", "DangSP")" class="admin-box">
                    <i class="fa fa-plus-circle"></i>
                    <h4>Đăng sản phẩm</h4>
                    <p>Thêm sản phẩm mới vào shop</p>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .admin-dashboard {
        padding-top: 80px;
        padding-bottom: 80px;
    }

    .admin-title {
        font-size: 32px;
        font-weight: 700;
        color: #252525;
        margin-bottom: 50px;
        font-family: 'Muli', sans-serif;
    }

    .admin-box-wrap {
        display: flex;
        justify-content: center;
    }

    .admin-box {
        display: block;
        background: #ffffff;
        border: 1px solid #ebebeb;
        text-align: center;
        padding: 40px 20px;
        margin-bottom: 30px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .admin-box i {
            font-size: 42px;
            color: #e7ab3c; /* màu vàng Fashi */
            margin-bottom: 20px;
        }

        .admin-box h4 {
            font-size: 20px;
            font-weight: 600;
            color: #252525;
            margin-bottom: 10px;
        }

        .admin-box p {
            font-size: 14px;
            color: #636363;
        }

        .admin-box:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            transform: translateY(-5px);
        }

   @* .admin-section {
        padding-top: 80px;
