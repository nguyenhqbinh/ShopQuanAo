<!-- Related Products Section End -->
@{
    var spLienQuan = ViewBag.SanPhamLienQuan as List<ShopQuanAo.Models.QuanAo>;
}
@if (spLienQuan != null && spLienQuan.Any())
{
    <div class="related-products spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <h2>Sản phẩm liên quan</h2>
                    </div>
                </div>
            </div>

            <div class="row">
                @foreach (var item in spLienQuan)
                {
                    <div class="col-lg-3 col-sm-6">
                        <div class="product-item">
                            <div class="pi-pic">
                                <img src="@Url.Content("~/Content/img/" +
    (item.HinhAnh.Contains("/")
        ? item.HinhAnh
        : "QuanAo/" + item.HinhAnh)
)" alt="@item.TenQuanAo" />

                                <div class="icon">
                                    <i class="icon_heart_alt"></i>
                                </div>

                                <ul>
                                    <li class="w-icon active">
                                        <a href="#"><i class="icon_bag_alt"></i></a>
                                    </li>
                                    <li class="quick-view">
                                        <a href="@Url.Action("Index","ChiTiet", new { id = item.MaQuanAo })">
                                            + Xem nhanh
                                        </a>
                                    </li>
                                    <li class="w-icon">
                                        <a href="#"><i class="fa fa-random"></i></a>
                                    </li>
                                </ul>
                            </div>

                            <div class="pi-text">
                                <div class="catagory-name">
                                    @item.TheLoai.TenTheLoai
                                </div>

                                <a href="@Url.Action("Index","ChiTiet", new { id = item.MaQuanAo })">
                                    <h5>@item.TenQuanAo</h5>
                                </a>

                                <div class="product-price">
                                    @String.Format("{0:N0} đ", item.Gia)
                                    <span>@String.Format("{0:N0} đ", item.Gia + 100000)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
<!-- Related Products Section End -->
@Html.Action("Footer", "Home")

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý tăng/giảm số lượng
            var quantityInput = $('#quantity');
            var minQuantity = 1;
            var maxQuantity = @Model.SoLuongTon;

            $('.qtybtn.dec').on('click', function (e) {
                e.stopImmediatePropagation();   
                var currentValue = parseInt(quantityInput.val());
                if (currentValue > minQuantity) {
                    quantityInput.val(currentValue - 1);
                }
            });

            $('.qtybtn.inc').on('click', function (e) {
                e.stopImmediatePropagation();   
                var currentValue = parseInt(quantityInput.val());
                if (currentValue < maxQuantity) {
                    quantityInput.val(currentValue + 1);
                } else {
                    alert('Số lượng không được vượt quá số lượng tồn kho!');
                }
            });

            // Xử lý thêm vào giỏ hàng
            var maxQuantity = @Model.SoLuongTon;

            $('#btnThemVaoGioHang').on('click', function (e) {
        e.preventDefault();

        var quantity = parseInt($('#quantity').val());
        var productId = @Model.MaQuanAo;

        if (isNaN(quantity) || quantity <= 0 || quantity > maxQuantity) {
            alert('Số lượng không hợp lệ!');
            return;
        }

        var btn = $(this);
        var originalText = btn.html();
        btn.html('Đang xử lý...').prop('disabled', true);
        $('#cartMessage').html('');

        $.ajax({
            url: '@Url.Action("ThemVaoGioHang", "ChiTiet")',
            type: 'POST',
            data: {
                id: productId,
                soLuong: quantity
            },
            success: function (response) {
                if (response.success) {
                    $('#cartMessage').html(
                        '<div class="alert alert-success">' + response.message + '</div>'
                    );
                    $('#quantity').val(1);
                } else {
                    if (response.requireLogin) {
                        // Nếu cần đăng nhập, chuyển đến trang đăng nhập
                        if (confirm(response.message + '\nBạn có muốn chuyển đến trang đăng nhập không?')) {
                            window.location.href = '@Url.Action("DangNhap", "Authen")';
                        }
                    } else {
                        $('#cartMessage').html(
                            '<div class="alert alert-danger">' + response.message + '</div>'
                        );
                    }
                }
            },
            error: function () {
                $('#cartMessage').html(
                    '<div class="alert alert-danger">Có lỗi xảy ra!</div>'
                );
            },
            complete: function () {
                btn.html(originalText).prop('disabled', false);
            }
        });
    });

});
    </script>
}
